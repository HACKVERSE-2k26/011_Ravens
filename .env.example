# ---- Core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://root:root@localhost:3306/bloodbridge

# ---- Auth ----
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# ---- Email ----
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=BloodBridge <no-reply@bloodbridge.local>

# ---- Maps / Location ----
GOOGLE_MAPS_API_KEY=

# ---- Matching weights (must sum to 1.0) ----
MATCH_COMPATIBILITY_WEIGHT=0.30
MATCH_AVAILABILITY_WEIGHT=0.20
MATCH_DISTANCE_WEIGHT=0.20
MATCH_ELIGIBILITY_WEIGHT=0.15
MATCH_RESPONSE_WEIGHT=0.10
MATCH_TRAVEL_WEIGHT=0.05

# ---- Matching behavior ----
MATCH_INITIAL_CONTACT_COUNT=5
MATCH_SEARCH_RADIUS_KM=10

# ---- Integration secret (internal APIs) ----
INTERNAL_INTEGRATION_SECRET=change_this_in_production

# ---- Future: n8n ----
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ---- Future: Redis / background jobs ----
REDIS_URL=

# ---- Future: SMS ----
SMS_PROVIDER=
SMS_API_KEY=

# ---- Future: Voice agent ----
VOICE_AGENT_URL=
VOICE_AGENT_SECRET=
